      "name": "to-architecture-fresh",
      "dir": "evals/to-architecture-fresh",
      "source": "prose",
      "promptMarkdown": "We're replacing the CLI's ad-hoc logging with structured logs, in three steps.\nFirst a logger core that every command gets through a shared context object,\nemitting JSON lines. Then each command migrates from console.log to that\nlogger, one command group at a time. Last, a `--log-level` flag and a redaction\nfilter that strips tokens before anything is written.\n\nTechnically: the logger core is a new `src/log/` module; the context object is\nthe existing `src/cli/context.ts`, which gains a `log` field. The migration\nitems depend on the core landing first, and the redaction filter plugs into the\ncore's write path, so it needs the core too. Commands never import the logger\ndirectly — they only see it through the context.\n\n/task:to-architecture capture the roadmap with its architecture",
      "runsPerCase": 2,
      "timeoutSeconds": 300,
      "maxTurns": 30,
      "graders": [
        {
          "name": "digest-line",
          "type": "regex",
          "weight": 1,
          "config": {
            "target": "last_message",
            "pattern": "(?m)^Architecture: \\d+ components?",
            "flags": "",
            "match": "contains"
          }
        },
        {
          "name": "section-written",
          "type": "regex",
          "weight": 1,
          "config": {
            "target": {
              "source": "file",
              "path": "**/.task/roadmap/*.md"
            },
            "pattern": "(?m)^## Architecture\\s*$[\\s\\S]*^### Components\\s*$",
            "flags": "",
            "match": "contains"
          }
        },
        {
          "name": "skill-fired",
          "type": "tool_used",
          "weight": 1,
          "config": {
            "tool": "Skill",
            "input_match": "\"skill\"\\s*:\\s*\"(?:[\\w-]+:)?to-architecture\""
          }
        }
      ],
