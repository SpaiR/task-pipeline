# Editor defaults for this repo, see https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# The Makefile fixture in its heredoc needs literal tabs.
[tests/detect-project.test.sh]
indent_style = unset
