{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bash tests/run.sh *)",
      "Bash(bash skills/validate/validate.sh *)",
      "Bash(claude plugin validate *)",
      "Bash(npm --prefix website ci)",
      "Bash(npm --prefix website run docs:build)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-release-files.sh\""
          }
        ]
      }
    ]
  }
}
